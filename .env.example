# Steadfast — Supabase configuration (EXAMPLE ONLY)
#
# Copy this file to `.env` (git-ignored) for CLI / build tooling, and/or copy
# `config.example.js` to `config.local.js` for the browser prototype.
# NEVER commit real keys. The anon key is safe to expose to the browser;
# the service_role key must stay server-side only and must never ship to clients.

# Project URL, e.g. https://abcdefghijklmno.supabase.co
SUPABASE_URL=

# Public anon key (browser-safe; protected by Row Level Security).
SUPABASE_ANON_KEY=

# Service role key — SERVER/CLI ONLY. Do NOT put this in client code or commit it.
# Used for migrations/admin scripts. Leave blank unless running admin tooling.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: project ref used by the Supabase CLI (the subdomain of SUPABASE_URL).
SUPABASE_PROJECT_REF=
